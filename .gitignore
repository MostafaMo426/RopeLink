# ==============================================================================
# RopeLink - Git Ignore Policy
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build & Outputs
/.next/
/out/
/build
/dist

# Production & Local Environment Variables (NEVER commit secrets!)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Supabase Local Credentials & Temp Storage
/.supabase/
supabase/.branches/
supabase/.temp/

# Private Keys & Certificates
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519

# TypeScript Caches & Build Info
*.tsbuildinfo
next-env.d.ts

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Diagnostic & Crash Dumps
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.heapsnapshot

# Testing & Coverage
/coverage
/.nyc_output

# Compiled Binary Reports & Generated PDFs
*.pdf

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Vercel Deployment Metadata
.vercel

# Temporary / Scratch Files
/scratch/
*.tmp
*.temp
